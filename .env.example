# -----------------------------------------------
# ANEFFY — Variables de Entorno
# Copia este archivo como .env y llena los valores
# NUNCA subas el archivo .env al repositorio
# -----------------------------------------------

# Destinatario principal de los formularios de cotización
CONTACT_EMAIL_TO=ventas@anaerobia.com

# Correo remitente (debe estar verificado en tu proveedor SMTP)
CONTACT_EMAIL_FROM=noreply@anaerobia.com

# Nombre del remitente que aparece en el email
CONTACT_EMAIL_FROM_NAME="ANEFFY Filtros Industriales"

# Configuración SMTP (Brevo, Mailgun, SMTP2GO, etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_usuario@ejemplo.com
SMTP_PASS=tu_contraseña_smtp

# (Opcional) API Key de Brevo si usas su API directamente
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Clave secreta para reCAPTCHA v3
RECAPTCHA_SECRET_KEY=

# Entorno de ejecución
PUBLIC_SITE_URL=https://www.aneffy.com
