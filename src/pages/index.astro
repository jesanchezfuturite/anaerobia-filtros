---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ANEFFY | Filtros Industriales de Máxima Eficiencia">

  <!-- ================================================
       HERO SECTION
       ================================================ -->
  <section
    id="hero"
    class="relative min-h-[85vh] flex items-center overflow-hidden"
    aria-labelledby="hero-heading"
  >
    <!-- Fondo: gradiente + grid decorativo -->
    <div class="absolute inset-0 -z-10" style="background: linear-gradient(135deg, #003141 0%, #00243a 55%, #001820 100%);"></div>
    <div
      class="absolute inset-0 -z-10 opacity-[0.05]"
      style="background-image: linear-gradient(rgba(154,195,28,1) 1px, transparent 1px), linear-gradient(90deg, rgba(154,195,28,1) 1px, transparent 1px); background-size: 56px 56px;"
      aria-hidden="true"
    ></div>

    <!-- Orbe decorativo derecha -->
    <div
      class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full -z-10 blur-3xl opacity-20"
      style="background: radial-gradient(circle, #0c5b8c 0%, transparent 70%);"
      aria-hidden="true"
    ></div>
    <!-- Acento lime inferior izquierdo -->
    <div
      class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full -z-10 blur-2xl opacity-15"
      style="background: #9ac31c;"
      aria-hidden="true"
    ></div>

    <div class="container-aneffy w-full py-28 md:py-36">
      <div class="max-w-4xl">

        <!-- Badge -->
        <div class="gsap-hero-item inline-flex items-center gap-3 mb-6">
          <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
          <span
            class="font-roboto tracking-widest text-xs uppercase font-semibold"
            style="color:#9ac31c;"
          >Refacción Original Anaerobia</span>
        </div>

        <!-- H1 -->
        <h1
          id="hero-heading"
          class="gsap-hero-item font-saira font-bold text-white leading-none tracking-wide uppercase"
          style="font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: 1.0;"
        >
          Máxima Eficiencia.<br />
          <span style="color:#9ac31c;">Cero Fricción</span><br />
          Logística.
        </h1>

        <!-- Párrafo de apoyo -->
        <p
          class="gsap-hero-item font-roboto font-light text-lg md:text-xl max-w-2xl mt-7 leading-relaxed"
          style="color: rgba(255,255,255,0.68);"
        >
          Filtros industriales diseñados con 100% de compatibilidad OEM para tus cabinas.
          Calidad técnica de excelencia, sin aranceles ni tiempos de espera internacionales.
        </p>

        <!-- Botones CTA -->
        <div class="gsap-hero-item flex flex-col sm:flex-row gap-4 mt-10">
          <a
            href="#cotizar"
            id="hero-cta-primary"
            class="btn-primary text-lg px-8 py-4"
          >
            <i class="ph ph-package text-xl" aria-hidden="true"></i>
            Cotizar Refacciones
          </a>
          <a
            href="#especificaciones"
            id="hero-cta-secondary"
            class="btn-secondary text-lg px-8 py-4"
          >
            <i class="ph ph-file-text text-xl" aria-hidden="true"></i>
            Ver Especificaciones
          </a>
        </div>

        <!-- Métricas de confianza -->
        <div class="gsap-hero-item flex flex-wrap gap-8 mt-14 pt-10 border-t" style="border-color: rgba(12,91,140,0.28);">
          {[
            { value: '100%', label: 'Compatibilidad OEM' },
            { value: '48h',  label: 'Entrega Nacional' },
            { value: '0%',   label: 'Aranceles de Importación' },
            { value: '+12',  label: 'Años en el Mercado' },
          ].map(({ value, label }) => (
            <div class="flex flex-col gap-1">
              <span class="font-saira font-bold text-3xl md:text-4xl" style="color:#9ac31c;">{value}</span>
              <span class="font-roboto text-xs tracking-wider uppercase" style="color:rgba(255,255,255,0.45);">{label}</span>
            </div>
          ))}
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-35" aria-hidden="true">
      <div class="w-5 h-8 rounded-full border flex justify-center pt-1.5" style="border-color:rgba(255,255,255,0.3);">
        <div class="w-1 h-2 rounded-full scroll-dot" style="background:#9ac31c;"></div>
      </div>
    </div>
  </section>

  <!-- ================================================
       BENTO GRID — VENTAJAS COMPETITIVAS
       ================================================ -->
  <section
    id="ventajas"
    class="py-24 overflow-hidden"
    style="background: linear-gradient(180deg, #001820 0%, #002535 100%);"
    aria-labelledby="ventajas-heading"
  >
    <div class="max-w-7xl mx-auto px-6">

      <!-- Encabezado de sección -->
      <div class="flex flex-col gap-3 max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
          <span class="font-roboto text-xs tracking-[0.25em] uppercase font-semibold" style="color:#9ac31c;">
            Ventajas Competitivas
          </span>
        </div>
        <h2
          id="ventajas-heading"
          class="font-saira font-bold uppercase text-white leading-tight"
          style="font-size: clamp(2rem, 4vw, 3.25rem);"
        >
          Por qué elegir<br/>
          <span style="color:#9ac31c;">Filtros ANEFFY</span>
        </h2>
        <p class="font-roboto font-light text-base leading-relaxed" style="color:rgba(255,255,255,0.6);">
          Ingeniería nacional con estándar internacional. Construidos para la continuidad operativa de tu planta.
        </p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16" style="grid-auto-rows: 280px;">

        <!-- Tarjeta 1 — Libre de Aranceles (2 cols) -->
        <article
          class="gsap-bento-card md:col-span-2 relative rounded-2xl p-8 flex flex-col justify-end overflow-hidden group transition-colors duration-300 cursor-default"
          style="background: rgba(255,255,255,0.04); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.09);"
        >
          <!-- Icono decorativo de fondo -->
          <div class="absolute top-6 right-6 opacity-10 group-hover:opacity-20 transition-opacity duration-300" aria-hidden="true">
            <i class="ph ph-shield-check" style="font-size: 7rem; color:#9ac31c;"></i>
          </div>
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(255,255,255,0.04);" aria-hidden="true"></div>
          <!-- Acento lime superior -->
          <div class="w-12 h-1 rounded-full mb-5" style="background:#9ac31c;" aria-hidden="true"></div>
          <h3 class="font-saira font-bold text-2xl md:text-3xl uppercase text-white leading-tight">
            Libre de Aranceles
          </h3>
          <p class="font-roboto font-light text-sm md:text-base mt-3 leading-relaxed" style="color:rgba(255,255,255,0.60); max-width: 420px;">
            Producción directa que elimina barreras de importación y sobrecostos, maximizando la rentabilidad de tu planta.
          </p>
        </article>

        <!-- Tarjeta 2 — Stock Inmediato (1 col) -->
        <article
          class="gsap-bento-card rounded-2xl p-8 flex flex-col justify-end overflow-hidden group transition-colors duration-300 cursor-default relative"
          style="background: rgba(154,195,28,0.08); backdrop-filter: blur(12px); border: 1px solid rgba(154,195,28,0.20);"
        >
          <div class="absolute top-6 right-6 opacity-15 group-hover:opacity-25 transition-opacity duration-300" aria-hidden="true">
            <i class="ph ph-lightning" style="font-size: 6rem; color:#9ac31c;"></i>
          </div>
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(154,195,28,0.05);" aria-hidden="true"></div>
          <div class="w-12 h-1 rounded-full mb-5" style="background:#9ac31c;" aria-hidden="true"></div>
          <h3 class="font-saira font-bold text-2xl uppercase text-white leading-tight">
            Stock Inmediato
          </h3>
          <p class="font-roboto font-light text-sm mt-3 leading-relaxed" style="color:rgba(255,255,255,0.60);">
            Disponibilidad nacional para envío rápido. Tu línea de producción nunca se detiene.
          </p>
        </article>

        <!-- Tarjeta 3 — Rendimiento OEM (3 cols, layout horizontal) -->
        <article
          class="gsap-bento-card md:col-span-3 rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-start md:items-end justify-between gap-6 overflow-hidden group transition-colors duration-300 cursor-default relative"
          style="background: rgba(12,91,140,0.15); backdrop-filter: blur(12px); border: 1px solid rgba(12,91,140,0.35);"
        >
          <!-- Orbe decorativo -->
          <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full blur-2xl opacity-20" style="background: #0c5b8c;" aria-hidden="true"></div>
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(12,91,140,0.08);" aria-hidden="true"></div>

          <div class="flex flex-col gap-4 max-w-2xl">
            <div class="w-12 h-1 rounded-full" style="background:#9ac31c;" aria-hidden="true"></div>
            <h3 class="font-saira font-bold text-3xl md:text-4xl uppercase text-white leading-tight">
              Rendimiento OEM<br />
              <span style="color:#9ac31c;">Garantizado</span>
            </h3>
            <p class="font-roboto font-light text-base leading-relaxed" style="color:rgba(255,255,255,0.65);">
              Diseñados bajo las mismas especificaciones de fábrica de los equipos Anaerobia.
              Ajuste perfecto, filtración impecable.
            </p>
          </div>

          <!-- Lista de specs inline -->
          <ul class="flex flex-wrap gap-4 shrink-0">
            {[
              'Tolerancia ±0.01mm',
              'Presión: hasta 16 bar',
              'ISO 9001:2015',
              'Temp. -40°C a +120°C',
            ].map((spec) => (
              <li
                class="font-roboto text-xs tracking-wider uppercase px-4 py-2 rounded-sm border"
                style="color:#9ac31c; border-color:rgba(154,195,28,0.30); background:rgba(154,195,28,0.07);"
              >
                {spec}
              </li>
            ))}
          </ul>
        </article>

      </div>
    </div>
  </section>

  <!-- ================================================
       SECCIÓN: CÓMO FUNCIONA (3 pasos)
       ================================================ -->
  <section
    id="especificaciones"
    class="py-24"
    style="background: #001e2e;"
    aria-labelledby="proceso-heading"
  >
    <div class="container-aneffy">
      <div class="flex flex-col items-center text-center gap-3 mb-16">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
          <span class="font-roboto text-xs tracking-[0.25em] uppercase font-semibold" style="color:#9ac31c;">Proceso Simple</span>
          <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
        </div>
        <h2 id="proceso-heading" class="font-saira font-bold uppercase text-white" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem);">
          Tres Pasos para Tu Refacción
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            step: '01',
            icon: 'ph-magnifying-glass',
            title: 'Identifica tu Filtro',
            desc: 'Compártenos el número de parte, modelo de cabina o especificación técnica. Nuestro equipo lo localiza de inmediato.',
          },
          {
            step: '02',
            icon: 'ph-chat-circle-dots',
            title: 'Recibe tu Cotización',
            desc: 'En menos de 2 horas hábiles recibes precio, disponibilidad y tiempo de entrega directamente en tu correo o WhatsApp.',
          },
          {
            step: '03',
            icon: 'ph-truck',
            title: 'Entrega Express',
            desc: 'Envío desde nuestros almacenes nacionales. Sin cruces aduanales, sin esperas. Tu filtro en planta en 24-48 horas.',
          },
        ].map(({ step, icon, title, desc }) => (
          <div class="gsap-bento-card flex flex-col gap-5 p-8 rounded-2xl relative overflow-hidden" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
            <span class="font-saira font-bold text-7xl absolute top-4 right-6 leading-none select-none" style="color:rgba(154,195,28,0.08);">{step}</span>
            <div class="w-12 h-12 rounded-md flex items-center justify-center" style="background:rgba(154,195,28,0.12);">
              <i class={`ph ${icon} text-2xl`} style="color:#9ac31c;" aria-hidden="true"></i>
            </div>
            <div class="w-8 h-0.5 rounded-full" style="background:#9ac31c;" aria-hidden="true"></div>
            <h3 class="font-saira font-bold text-xl uppercase text-white">{title}</h3>
            <p class="font-roboto font-light text-sm leading-relaxed" style="color:rgba(255,255,255,0.60);">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================
       SECCIÓN: CTA FINAL — COTIZACIÓN
       ================================================ -->
  <section
    id="cotizar"
    class="py-28 relative overflow-hidden"
    style="background: linear-gradient(135deg, #003141 0%, #0c5b8c 100%);"
    aria-labelledby="cta-heading"
  >
    <!-- Grid decorativo -->
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(rgba(154,195,28,1) 1px, transparent 1px), linear-gradient(90deg, rgba(154,195,28,1) 1px, transparent 1px); background-size: 48px 48px;"
      aria-hidden="true"
    ></div>
    <div class="container-aneffy relative z-10 flex flex-col items-center text-center gap-6">
      <div class="flex items-center gap-3">
        <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
        <span class="font-roboto text-xs tracking-[0.25em] uppercase font-semibold" style="color:#9ac31c;">Contacto Directo</span>
        <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
      </div>
      <h2 id="cta-heading" class="font-saira font-bold uppercase text-white" style="font-size: clamp(2rem, 5vw, 4rem); line-height:1.05;">
        ¿Necesitas un Filtro<br />
        <span style="color:#9ac31c;">Ahora Mismo?</span>
      </h2>
      <p class="font-roboto font-light text-lg max-w-xl leading-relaxed" style="color:rgba(255,255,255,0.72);">
        Habla con un especialista en filtración industrial. Respuesta garantizada en menos de 2 horas hábiles.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-4">
        <a href="mailto:ventas@anaerobia.com" class="btn-primary text-lg px-10 py-4">
          <i class="ph ph-envelope-simple text-xl" aria-hidden="true"></i>
          Enviar Cotización
        </a>
        <a href="https://wa.me/528000000000" target="_blank" rel="noopener noreferrer" class="btn-secondary text-lg px-10 py-4">
          <i class="ph ph-whatsapp-logo text-xl" aria-hidden="true"></i>
          WhatsApp Directo
        </a>
      </div>
    </div>
  </section>

</Layout>

<!-- ================================================
     ANIMACIONES GSAP
     ================================================ -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Espera a que GSAP esté disponible
    function initAnimations() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initAnimations, 100);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      // ── Hero: animación de entrada en cascada ──
      const heroItems = document.querySelectorAll('.gsap-hero-item');
      if (heroItems.length) {
        gsap.from(heroItems, {
          y: 50,
          opacity: 0,
          stagger: 0.2,
          duration: 1,
          ease: 'power3.out',
          delay: 0.3,
        });
      }

      // ── Bento Cards: aparecen al hacer scroll ──
      const bentoCards = document.querySelectorAll('.gsap-bento-card');
      if (bentoCards.length) {
        gsap.from(bentoCards, {
          scrollTrigger: {
            trigger: bentoCards[0],
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
          y: 50,
          opacity: 0,
          stagger: 0.15,
          duration: 0.8,
          ease: 'power2.out',
        });
      }
    }

    // Inicializa cuando GSAP esté listo
    document.addEventListener('gsap:ready', initAnimations);
    // Fallback: intenta inicializar de todas formas
    setTimeout(initAnimations, 500);
  });
</script>

<style>
  /* Scroll dot animation */
  .scroll-dot {
    animation: scrollBounce 1.8s ease-in-out infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%       { transform: translateY(10px); opacity: 0.3; }
  }
</style>
