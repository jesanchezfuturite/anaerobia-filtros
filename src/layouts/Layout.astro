---
// src/layouts/Layout.astro
// Layout base para ANEFFY — Filtros Industriales B2B
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'ANEFFY | Filtros Industriales de Alta Eficiencia — Anaerobia',
  description = 'ANEFFY es la línea de filtros industriales de Anaerobia. Soluciones de filtración de alto rendimiento para la industria manufacturera, alimentos y proceso. Cotiza hoy.',
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonicalURL = Astro.url.href;
---

<!doctype html>
<html lang="es-MX" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- === SEO === -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:title"      content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"      content={ogImage} />

    <!-- === Favicon === -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- === Google Fonts: Saira Condensed + Roboto Condensed === -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700&family=Roboto+Condensed:wght@300;400;700&display=swap"
      rel="stylesheet"
    />

    <!-- === Phosphor Icons === -->
    <script src="https://unpkg.com/@phosphor-icons/web" is:inline></script>

    <!-- === GSAP + ScrollTrigger CDN === -->
    <script is:inline>
      // GSAP cargado inline para disponibilidad inmediata en todo el sitio
      (function() {
        var gsapScript = document.createElement('script');
        gsapScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
        gsapScript.onload = function() {
          var stScript = document.createElement('script');
          stScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js';
          stScript.onload = function() {
            if (window.gsap && window.ScrollTrigger) {
              gsap.registerPlugin(ScrollTrigger);
              document.dispatchEvent(new CustomEvent('gsap:ready'));
            }
          };
          document.head.appendChild(stScript);
        };
        document.head.appendChild(gsapScript);
      })();
    </script>
  </head>

  <body>
    <!-- ================================================
         NAVBAR — Glassmorphism Sticky
         ================================================ -->
    <header
      id="navbar"
      class="sticky top-0 z-50 w-full backdrop-blur-md border-b transition-all duration-300"
      style="background: rgba(0,49,65,0.82); border-color: rgba(12,91,140,0.30);"
    >
      <nav class="container-aneffy flex items-center justify-between h-16 md:h-18">

        <!-- Logotipo -->
        <a href="/" aria-label="ANEFFY — Inicio" class="flex items-center gap-3 group">
          <!-- Ícono SVG inline como placeholder del logo -->
          <div
            class="flex items-center justify-center w-9 h-9 rounded-sm transition-transform duration-200 group-hover:scale-105"
            style="background: #9ac31c;"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="w-5 h-5">
              <!-- Ícono representativo de filtro industrial -->
              <path d="M3 4h18v2.5L13 12v7l-2-1v-6L3 6.5V4z" fill="#003141"/>
            </svg>
          </div>
          <div class="flex flex-col leading-none">
            <span
              class="font-saira font-semibold text-xl tracking-widest uppercase text-white"
            >ANEFFY</span>
            <span class="text-[10px] tracking-[0.18em] uppercase" style="color: #9ac31c;">
              Filtros Industriales
            </span>
          </div>
        </a>

        <!-- Links de navegación (desktop) -->
        <ul class="hidden md:flex items-center gap-8 text-sm font-roboto font-light tracking-wide">
          <li>
            <a
              href="#soluciones"
              class="text-white/70 hover:text-white transition-colors duration-200"
            >Soluciones</a>
          </li>
          <li>
            <a
              href="#industrias"
              class="text-white/70 hover:text-white transition-colors duration-200"
            >Industrias</a>
          </li>
          <li>
            <a
              href="#nosotros"
              class="text-white/70 hover:text-white transition-colors duration-200"
            >Nosotros</a>
          </li>
          <li>
            <a
              href="#contacto"
              class="text-white/70 hover:text-white transition-colors duration-200"
            >Contacto</a>
          </li>
        </ul>

        <!-- CTA Principal -->
        <a
          href="#cotizar"
          id="navbar-cta"
          class="btn-primary text-sm hidden sm:inline-flex"
        >
          <i class="ph ph-chat-circle-dots text-base" aria-hidden="true"></i>
          Cotizar Filtros
        </a>

        <!-- Menú hamburguesa (mobile) -->
        <button
          id="mobile-menu-btn"
          class="sm:hidden flex flex-col gap-1.5 p-2 rounded-md transition-colors hover:bg-white/10"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-6 h-0.5 bg-white transition-transform duration-300" id="ham-1"></span>
          <span class="block w-6 h-0.5 bg-white transition-opacity duration-300"  id="ham-2"></span>
          <span class="block w-6 h-0.5 bg-white transition-transform duration-300" id="ham-3"></span>
        </button>
      </nav>

      <!-- Menú mobile desplegable -->
      <div
        id="mobile-menu"
        class="sm:hidden hidden flex-col gap-0 border-t"
        style="background: rgba(0,36,48,0.96); border-color: rgba(12,91,140,0.25);"
      >
        <a href="#soluciones" class="px-6 py-4 text-white/80 hover:text-white hover:bg-white/5 transition-colors font-roboto text-sm tracking-wide border-b" style="border-color: rgba(12,91,140,0.15);">Soluciones</a>
        <a href="#industrias" class="px-6 py-4 text-white/80 hover:text-white hover:bg-white/5 transition-colors font-roboto text-sm tracking-wide border-b" style="border-color: rgba(12,91,140,0.15);">Industrias</a>
        <a href="#nosotros"   class="px-6 py-4 text-white/80 hover:text-white hover:bg-white/5 transition-colors font-roboto text-sm tracking-wide border-b" style="border-color: rgba(12,91,140,0.15);">Nosotros</a>
        <a href="#contacto"   class="px-6 py-4 text-white/80 hover:text-white hover:bg-white/5 transition-colors font-roboto text-sm tracking-wide border-b" style="border-color: rgba(12,91,140,0.15);">Contacto</a>
        <div class="px-6 py-4">
          <a href="#cotizar" class="btn-primary w-full justify-center text-sm">
            <i class="ph ph-chat-circle-dots text-base" aria-hidden="true"></i>
            Cotizar Filtros
          </a>
        </div>
      </div>
    </header>

    <!-- ================================================
         CONTENIDO PRINCIPAL
         ================================================ -->
    <main id="main-content">
      <slot />
    </main>

    <!-- ================================================
         FOOTER — Corporativo Minimalista
         ================================================ -->
    <footer
      class="w-full border-t"
      style="background: #001e2e; border-color: rgba(12,91,140,0.25);"
    >
      <!-- Franja superior -->
      <div class="container-aneffy py-10 grid grid-cols-1 md:grid-cols-3 gap-8 border-b" style="border-color: rgba(12,91,140,0.18);">

        <!-- Columna: Marca -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-sm flex items-center justify-center" style="background:#9ac31c;" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="w-4 h-4">
                <path d="M3 4h18v2.5L13 12v7l-2-1v-6L3 6.5V4z" fill="#003141"/>
              </svg>
            </div>
            <span class="font-saira font-semibold text-lg tracking-widest uppercase text-white">ANEFFY</span>
          </div>
          <p class="text-xs font-roboto leading-relaxed" style="color:#8da8b8;">
            Soluciones de filtración industrial de alto rendimiento para los procesos más exigentes. Una marca de Anaerobia.
          </p>
        </div>

        <!-- Columna: Navegación rápida -->
        <div class="flex flex-col gap-3">
          <h3 class="text-xs font-saira font-semibold tracking-[0.2em] uppercase" style="color:#9ac31c;">
            Navegación
          </h3>
          <ul class="flex flex-col gap-1.5 text-sm font-roboto" style="color:#8da8b8;">
            <li><a href="#soluciones" class="hover:text-white transition-colors">Soluciones</a></li>
            <li><a href="#industrias" class="hover:text-white transition-colors">Industrias</a></li>
            <li><a href="#nosotros"   class="hover:text-white transition-colors">Nosotros</a></li>
            <li><a href="#contacto"   class="hover:text-white transition-colors">Contacto</a></li>
          </ul>
        </div>

        <!-- Columna: Contacto -->
        <div class="flex flex-col gap-3">
          <h3 class="text-xs font-saira font-semibold tracking-[0.2em] uppercase" style="color:#9ac31c;">
            Contacto
          </h3>
          <ul class="flex flex-col gap-2 text-sm font-roboto" style="color:#8da8b8;">
            <li class="flex items-center gap-2">
              <i class="ph ph-envelope-simple text-base" style="color:#9ac31c;" aria-hidden="true"></i>
              <a href="mailto:ventas@anaerobia.com" class="hover:text-white transition-colors">
                ventas@anaerobia.com
              </a>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-phone text-base" style="color:#9ac31c;" aria-hidden="true"></i>
              <a href="tel:+528000000000" class="hover:text-white transition-colors">
                +52 800 000 0000
              </a>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-map-pin text-base" style="color:#9ac31c;" aria-hidden="true"></i>
              <span>México · LATAM</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Franja inferior: Copyright -->
      <div class="container-aneffy py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-xs font-roboto font-light" style="color:#8da8b8;">
          ANAEROBIA © 2026. Todos los derechos reservados.
        </p>
        <div class="flex items-center gap-5 text-xs font-roboto" style="color:#8da8b8;">
          <a href="/privacidad" class="hover:text-white transition-colors">Aviso de Privacidad</a>
          <span aria-hidden="true" class="opacity-30">|</span>
          <a href="/terminos"   class="hover:text-white transition-colors">Términos de Uso</a>
          <span aria-hidden="true" class="opacity-30">|</span>
          <a href="#cotizar"    class="hover:text-white transition-colors" style="color:#9ac31c;">Cotizar</a>
        </div>
      </div>
    </footer>

    <!-- ================================================
         SCRIPTS DE INTERACTIVIDAD
         ================================================ -->
    <script is:inline>
      // ── Menú mobile toggle ──
      const btn  = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const ham1 = document.getElementById('ham-1');
      const ham2 = document.getElementById('ham-2');
      const ham3 = document.getElementById('ham-3');

      if (btn && menu) {
        btn.addEventListener('click', () => {
          const isOpen = menu.classList.contains('flex');
          menu.classList.toggle('hidden', isOpen);
          menu.classList.toggle('flex', !isOpen);
          btn.setAttribute('aria-expanded', String(!isOpen));

          // Animación hamburguesa → X
          if (!isOpen) {
            ham1.style.transform = 'translateY(7px) rotate(45deg)';
            ham2.style.opacity   = '0';
            ham3.style.transform = 'translateY(-7px) rotate(-45deg)';
          } else {
            ham1.style.transform = '';
            ham2.style.opacity   = '';
            ham3.style.transform = '';
          }
        });

        // Cerrar menú al hacer clic en un enlace
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            menu.classList.remove('flex');
            btn.setAttribute('aria-expanded', 'false');
            ham1.style.transform = '';
            ham2.style.opacity   = '';
            ham3.style.transform = '';
          });
        });
      }

      // ── Navbar scroll shadow ──
      const navbar = document.getElementById('navbar');
      if (navbar) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 20) {
            navbar.style.boxShadow = '0 4px 24px rgba(0,0,0,0.35)';
          } else {
            navbar.style.boxShadow = 'none';
          }
        }, { passive: true });
      }

      // ── GSAP: animación de entrada navbar ──
      document.addEventListener('gsap:ready', () => {
        gsap.from('#navbar', {
          y: -80,
          opacity: 0,
          duration: 0.8,
          ease: 'power3.out',
        });
      });
    </script>
  </body>
</html>
